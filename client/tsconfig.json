{
  "extends": "../tsconfig.json",
  "include": ["src/**/*", "../shared/**/*"],
  "exclude": ["node_modules", "build", "dist", "**/*.test.ts"],
  "compilerOptions": {
    "composite": true,
    "lib": ["esnext", "dom", "dom.iterable"],
    "types": ["node", "vite/client"],
    "baseUrl": "..",
    "paths": {
      "@/*": ["./client/src/*"],
      "@shared/*": ["./shared/*"]
    }
  }
}
