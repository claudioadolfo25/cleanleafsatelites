# ==============================================================================
# Cleanleaf MVP v8.0 — Configuration & Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (Vercel / Cloudflare Pages)
# Note: Only variables with VITE_ prefix are exposed to the browser.
# ------------------------------------------------------------------------------
# URL of the backend API (Railway / Render / PaaS instance)
VITE_API_URL=https://api.cleanleaf.cl

# Supabase Public Anonymous Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional Analytics Configuration
VITE_ANALYTICS_ENDPOINT=https://analytics.example.com
VITE_ANALYTICS_WEBSITE_ID=your-website-id

# ------------------------------------------------------------------------------
# BACKEND CONFIGURATION (Railway / Render / PaaS Server)
# NEVER add VITE_ prefix to secrets below!
# ------------------------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
NODE_ENV=production
CORS_ORIGIN=https://cleanleaf.vercel.app

# Database & Auth Persistence
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
JWT_SECRET=super-secret-jwt-signing-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Copernicus CDSE Satellite OAuth2 Credentials
COPERNICUS_CLIENT_ID=your-copernicus-client-id
COPERNICUS_CLIENT_SECRET=your-copernicus-client-secret

# Satellite Domain Fail-Safe Configuration (Optional Overrides)
CLEANLEAF_SATELITES_HABILITADOS_AGRICULTURA=sentinel-2,sentinel-1
CLEANLEAF_SATELITES_HABILITADOS_ACUICULTURA=sentinel-3,sentinel-2
CLEANLEAF_SATELITES_HABILITADOS_FORESTAL=sentinel-2,sentinel-1
CLEANLEAF_TIER1_MAX_HA=50
CLEANLEAF_TIER2_MAX_HA=5000
