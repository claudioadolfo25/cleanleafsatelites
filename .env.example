# Server Environment Variables
PORT=3000
NODE_ENV=production

# Supabase Database & Auth (Server & Client)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Client Vite Public Environment Variables
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# SMS OTP Provider (ej. Twilio via Supabase Auth)
# Para habilitar SMS OTP en Supabase Auth, configura Twilio/MessageBird en el Dashboard de Supabase.
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_MESSAGE_SERVICE_SID=your-twilio-messaging-service-sid

# Copernicus Data Space Ecosystem (CDSE) API Credentials
COPERNICUS_MODE=live
COPERNICUS_CLIENT_ID=sh-79ab7ae6-ca8d-4823-90d1-fca2c30fe535
COPERNICUS_CLIENT_SECRET=
COPERNICUS_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
COPERNICUS_CATALOG_URL=https://sh.dataspace.copernicus.eu/catalog/v1/search

# OAuth & Session Configuration
OAUTH_SERVER_URL=https://oauth.example.com
APP_ID=cleanleaf-app
COOKIE_SECRET=your-cookie-secret-key-at-least-32-chars

# Storage Proxy (Manus Storage)
FORGE_API_URL=https://storage.example.com
FORGE_API_KEY=your-forge-api-key
