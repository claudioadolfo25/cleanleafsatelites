# ==============================================================================
# AgroPulso / Cleanleaf — Configuration & Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (Vercel / Cloudflare Pages)
# Note: Only variables with VITE_ prefix are exposed to the browser.
# ------------------------------------------------------------------------------
VITE_API_URL=https://api.cleanleaf.cl
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_ANALYTICS_ENDPOINT=https://analytics.example.com
VITE_ANALYTICS_WEBSITE_ID=your-website-id

# ------------------------------------------------------------------------------
# BACKEND CONFIGURATION (Railway / Render / PaaS Server)
# NEVER add VITE_ prefix to secrets below!
# ------------------------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
NODE_ENV=production
CORS_ORIGIN=https://cleanleaf.vercel.app

# Database & Auth Persistence
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
JWT_SECRET=super-secret-jwt-signing-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# External Service Abstract Providers (mock | sentinelhub | openweather | openai)
SATELLITE_PROVIDER=mock
SENTINEL_HUB_CLIENT_ID=your-sentinel-hub-client-id
SENTINEL_HUB_CLIENT_SECRET=your-sentinel-hub-client-secret

WEATHER_PROVIDER=mock
OPENWEATHER_API_KEY=your-openweather-api-key

LLM_PROVIDER=mock
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o

# Copernicus CDSE Satellite Credentials (Optional)
COPERNICUS_CLIENT_ID=your-copernicus-client-id
COPERNICUS_CLIENT_SECRET=your-copernicus-client-secret
