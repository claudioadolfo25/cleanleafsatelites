# Server & App Config
PORT=3000
NODE_ENV=development

# Database Configuration (MySQL / Drizzle for Demo)
DATABASE_URL=mysql://root:password@localhost:3306/cleanleaf

# Supabase (Future Migration & Staging)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Satellite Catalogs Configuration (Optional / Fallbacks)
CLEANLEAF_SATELITES_HABILITADOS_AGRICULTURA=sentinel-2,sentinel-1
CLEANLEAF_SATELITES_HABILITADOS_ACUICULTURA=sentinel-3,sentinel-2
CLEANLEAF_SATELITES_HABILITADOS_FORESTAL=sentinel-2,sentinel-1

# Tier Surface Thresholds (Hectares)
CLEANLEAF_TIER1_MAX_HA=50
CLEANLEAF_TIER2_MAX_HA=5000

# AI Agents & Workflows (Dify & n8n Stubs)
DIFY_API_KEY=your-dify-api-key
DIFY_API_URL=https://api.dify.ai/v1
N8N_WEBHOOK_URL=https://n8n.your-domain.com/webhook
